<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>VANGUARD MINE AI - Real-Time Mine Subsidence Monitoring & Early Warning System</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <link rel="stylesheet" href="style.css">
</head>
<body class="dark-theme">

    <header class="app-header">
        <div class="header-left">
            <div class="brand-logo">
                <i class="fa-solid fa-mountain-city logo-icon"></i>
                <div class="brand-text">
                    <h1>VANGUARD MINE AI</h1>
                    <p class="subtitle">AI-Enabled Real-Time Mine Subsidence Monitoring & Early Warning System</p>
                </div>
            </div>
            <div class="system-status-pill online">
                <span class="status-dot pulse"></span>
                <span>SYSTEM ONLINE</span>
            </div>
        </div>

        <div class="header-right">
            <div class="sih-badge">
                <span class="sih-title">SIH 2026</span>
                <span class="sih-id">PROBLEM STATEMENT ID: 26025</span>
                <span class="sih-org">Ministry of Coal | Coal India Ltd.</span>
            </div>
            
            <div class="connection-telemetry">
                <div class="telemetry-item">
                    <span class="label">LoRa Gateway:</span>
                    <span class="value status-ok" id="loraStatus">CONNECTED</span>
                </div>
                <div class="telemetry-item">
                    <span class="label">Cloud Sync:</span>
                    <span class="value status-ok" id="cloudStatus">CONNECTED</span>
                </div>
                <div class="telemetry-item">
                    <span class="label">Last Updated:</span>
                    <span class="value" id="lastUpdatedTime">10:42:16 AM</span>
                </div>
            </div>

            <div class="header-actions">
                <button class="icon-btn" id="btnNotifications" title="Notifications">
                    <i class="fa-regular fa-bell"></i>
                    <span class="badge-count" id="notificationCount">3</span>
                </button>
                <button class="icon-btn" id="btnSettings" title="System Settings">
                    <i class="fa-solid fa-gear"></i>
                </button>
                <div class="user-profile">
                    <i class="fa-solid fa-user-shield"></i>
                    <span>Control Room Admin</span>
                </div>
            </div>
        </div>
    </header>

    <div class="control-toolbar">
        <div class="toolbar-left">
            <nav class="main-nav">
                <button class="nav-tab active" data-tab="tab-dashboard"><i class="fa-solid fa-chart-line"></i> Dashboard</button>
                <button class="nav-tab" data-tab="tab-map"><i class="fa-solid fa-map-location-dot"></i> Live Risk Map</button>
                <button class="nav-tab" data-tab="tab-ai"><i class="fa-solid fa-brain"></i> AI Prediction</button>
                <button class="nav-tab" data-tab="tab-sensors"><i class="fa-solid fa-microchip"></i> Sensor Network</button>
                <button class="nav-tab" data-tab="tab-alerts"><i class="fa-solid fa-triangle-exclamation"></i> Alerts (<span id="activeAlertCount">3</span>)</button>
                <button class="nav-tab" data-tab="tab-analytics"><i class="fa-solid fa-clock-rotate-left"></i> Historical Analytics</button>
            </nav>
        </div>
        <div class="toolbar-right">
            <div class="demo-toggle-container">
                <label class="toggle-switch">
                    <input type="checkbox" id="demoModeToggle" checked>
                    <span class="slider round"></span>
                </label>
                <span class="demo-status-text" id="demoStatusText">● DEMO MODE ACTIVE</span>
            </div>
            <button class="btn btn-warning" id="btnSimulateEvent">
                <i class="fa-solid fa-bolt"></i> SIMULATE SUBSIDENCE EVENT
            </button>
            <button class="btn btn-secondary" id="btnResetSimulation">
                <i class="fa-solid fa-rotate-left"></i> RESET
            </button>
        </div>
    </div>

    <main class="dashboard-body container-fluid">

        <div class="workflow-banner">
            <div class="workflow-step"><i class="fa-solid fa-walkie-talkie"></i> <span>1. SENSE</span></div>
            <div class="workflow-arrow"><i class="fa-solid fa-chevron-right"></i></div>
            <div class="workflow-step"><i class="fa-solid fa-network-wired"></i> <span>2. CONNECT</span></div>
            <div class="workflow-arrow"><i class="fa-solid fa-chevron-right"></i></div>
            <div class="workflow-step"><i class="fa-solid fa-microchip"></i> <span>3. PROCESS</span></div>
            <div class="workflow-arrow"><i class="fa-solid fa-chevron-right"></i></div>
            <div class="workflow-step"><i class="fa-solid fa-brain"></i> <span>4. ANALYZE</span></div>
            <div class="workflow-arrow"><i class="fa-solid fa-chevron-right"></i></div>
            <div class="workflow-step"><i class="fa-solid fa-chart-line"></i> <span>5. PREDICT</span></div>
            <div class="workflow-arrow"><i class="fa-solid fa-chevron-right"></i></div>
            <div class="workflow-step danger"><i class="fa-solid fa-bell"></i> <span>6. WARN</span></div>
        </div>

        <div id="tab-dashboard" class="tab-content active">
            
            <section class="kpi-grid">
                <div class="glass-card kpi-card" id="kpi-card-nodes">
                    <div class="kpi-header">
                        <span class="kpi-title">TOTAL SENSOR NODES</span>
                        <i class="fa-solid fa-network-wired kpi-icon"></i>
                    </div>
                    <div class="kpi-body">
                        <div class="kpi-value-group">
                            <span class="kpi-value" id="kpiTotalNodes">24</span>
                            <span class="kpi-unit">Nodes</span>
                        </div>
                        <div class="kpi-sparkline"><canvas id="sparklineNodes"></canvas></div>
                    </div>
                    <div class="kpi-footer">
                        <span class="kpi-subtext ok"><i class="fa-solid fa-circle"></i> 22 ONLINE</span>
                        <span class="kpi-subtext alert"><i class="fa-solid fa-circle"></i> 2 OFFLINE</span>
                    </div>
                </div>

                <div class="glass-card kpi-card" id="kpi-card-tilt">
                    <div class="kpi-header">
                        <span class="kpi-title">GROUND TILT</span>
                        <i class="fa-solid fa-compass-drafting kpi-icon"></i>
                    </div>
                    <div class="kpi-body">
                        <div class="kpi-value-group">
                            <span class="kpi-value" id="kpiTilt">1.82</span>
                            <span class="kpi-unit">°</span>
                        </div>
                        <div class="kpi-sparkline"><canvas id="sparklineTilt"></canvas></div>
                    </div>
                    <div class="kpi-footer">
                        <span class="kpi-trend up" id="kpiTiltTrend"><i class="fa-solid fa-arrow-up"></i> ↑ 8.4%</span>
                        <span class="kpi-time">vs last hr</span>
                    </div>
                </div>

                <div class="glass-card kpi-card" id="kpi-card-displacement">
                    <div class="kpi-header">
                        <span class="kpi-title">SURFACE DISPLACEMENT</span>
                        <i class="fa-solid fa-arrows-up-down-left-right kpi-icon"></i>
                    </div>
                    <div class="kpi-body">
                        <div class="kpi-value-group">
                            <span class="kpi-value" id="kpiDisplacement">12.6</span>
                            <span class="kpi-unit">mm</span>
                        </div>
                        <div class="kpi-sparkline"><canvas id="sparklineDisplacement"></canvas></div>
                    </div>
                    <div class="kpi-footer">
                        <span class="kpi-trend up" id="kpiDispTrend"><i class="fa-solid fa-arrow-up"></i> ↑ 3.2 mm</span>
                        <span class="kpi-time">continuous shift</span>
                    </div>
                </div>

                <div class="glass-card kpi-card" id="kpi-card-vibration">
                    <div class="kpi-header">
                        <span class="kpi-title">SURFACE VIBRATION</span>
                        <i class="fa-solid fa-wave-square kpi-icon"></i>
                    </div>
                    <div class="kpi-body">
                        <div class="kpi-value-group">
                            <span class="kpi-value" id="kpiVibration">0.42</span>
                            <span class="kpi-unit">g</span>
                        </div>
                        <div class="kpi-sparkline"><canvas id="sparklineVibration"></canvas></div>
                    </div>
                    <div class="kpi-footer">
                        <span class="kpi-subtext ok" id="kpiVibStatus">Status: NORMAL</span>
                        <span class="kpi-time">0.1 - 0.5g norm</span>
                    </div>
                </div>

                <div class="glass-card kpi-card risk-warning" id="kpi-card-risk">
                    <div class="kpi-header">
                        <span class="kpi-title">SUBSIDENCE RISK</span>
                        <i class="fa-solid fa-shield-halved kpi-icon"></i>
                    </div>
                    <div class="kpi-body">
                        <div class="kpi-value-group">
                            <span class="kpi-value" id="kpiRiskCategory">MEDIUM</span>
                            <span class="kpi-unit" id="kpiRiskScore">62 / 100</span>
                        </div>
                        <div class="kpi-sparkline"><canvas id="sparklineRisk"></canvas></div>
                    </div>
                    <div class="kpi-footer">
                        <span class="kpi-trend warning" id="kpiRiskSub">AI Risk Engine Evaluation</span>
                    </div>
                </div>

                <div class="glass-card kpi-card alert-card" id="kpi-card-alerts">
                    <div class="kpi-header">
                        <span class="kpi-title">ACTIVE ALERTS</span>
                        <i class="fa-solid fa-bell kpi-icon pulse"></i>
                    </div>
                    <div class="kpi-body">
                        <div class="kpi-value-group">
                            <span class="kpi-value" id="kpiActiveAlerts">03</span>
                            <span class="kpi-unit">Active</span>
                        </div>
                        <div class="kpi-sparkline"><canvas id="sparklineAlerts"></canvas></div>
                    </div>
                    <div class="kpi-footer">
                        <span class="kpi-subtext critical" id="kpiAlertCritical">1 CRITICAL</span>
                        <span class="kpi-subtext warning" id="kpiAlertWarning">2 WARNING</span>
                    </div>
                </div>
            </section>

            <div class="dashboard-row grid-2-1">
                <div class="glass-card section-card map-section">
                    <div class="card-header">
                        <div class="header-title">
                            <i class="fa-solid fa-map-location-dot"></i>
                            <h3>LIVE SUBSIDENCE RISK MAP</h3>
                        </div>
                        <div class="map-controls-inline">
                            <button class="btn-sm active" id="btnLayerHeatmap"><i class="fa-solid fa-fire"></i> Risk Heatmap</button>
                            <button class="btn-sm active" id="btnLayerNodes"><i class="fa-solid fa-circle-dot"></i> Sensor Nodes</button>
                            <button class="btn-sm" id="btnResetMapView"><i class="fa-solid fa-compress"></i> Reset View</button>
                        </div>
                    </div>
                    <div class="card-body map-container">
                        <div id="leafletMap" class="map-view"></div>
                        <div class="map-legend">
                            <div class="legend-title">Risk Levels</div>
                            <div class="legend-item"><span class="color-box safe"></span> Safe (&lt; 40)</div>
                            <div class="legend-item"><span class="color-box low"></span> Low Risk (40-59)</div>
                            <div class="legend-item"><span class="color-box warning"></span> Warning (60-79)</div>
                            <div class="legend-item"><span class="color-box critical"></span> Critical (&ge; 80)</div>
                            <div class="legend-divider"></div>
                            <div class="legend-item"><i class="fa-solid fa-tower-cell" style="color: #06B6D4;"></i> LoRa Gateway</div>
                            <div class="legend-item"><i class="fa-solid fa-draw-polygon" style="color: rgba(239,68,68,0.5);"></i> Mine Boundary</div>
                        </div>
                    </div>
                </div>

                <div class="glass-card section-card ai-prediction-section">
                    <div class="card-header">
                        <div class="header-title">
                            <i class="fa-solid fa-brain"></i>
                            <h3>AI SUBSIDENCE PREDICTION</h3>
                        </div>
                        <span class="badge badge-cyan">MODEL ACTIVE</span>
                    </div>
                    <div class="card-body">
                        <div class="ai-score-container">
                            <div class="radial-gauge">
                                <svg viewBox="0 0 36 36" class="circular-chart">
                                    <path class="circle-bg" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
                                    <path class="circle" id="aiGaugeCircle" stroke-dasharray="62, 100" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
                                    <text x="18" y="17" class="percentage-val" id="aiScoreText">62</text>
                                    <text x="18" y="24" class="percentage-unit">/ 100</text>
                                </svg>
                            </div>
                            <div class="ai-risk-status-group">
                                <div class="risk-label-badge warning" id="aiRiskBadge">MEDIUM RISK</div>
                                <div class="meta-detail">Predicted Trend: <strong id="aiPredictedTrend" class="text-orange">INCREASING</strong></div>
                                <div class="meta-detail">Prediction Window: <strong>NEXT 6 HOURS</strong></div>
                                <div class="meta-detail">Confidence: <strong class="text-cyan">91%</strong></div>
                            </div>
                        </div>

                        <div class="ai-chart-wrapper">
                            <canvas id="aiPredictionChart"></canvas>
                        </div>

                        <div class="ai-explanation-box">
                            <div class="explanation-header"><i class="fa-solid fa-circle-question"></i> WHY IS RISK INCREASING?</div>
                            <ul class="explanation-list" id="aiExplanationList">
                                <li><i class="fa-solid fa-triangle-exclamation text-orange"></i> Ground tilt increased by 8.4% in Panel B-04.</li>
                                <li><i class="fa-solid fa-arrows-up-down text-orange"></i> Surface displacement increased by 3.2 mm continuously.</li>
                                <li><i class="fa-solid fa-diagram-project text-cyan"></i> 4 neighboring nodes (013, 014, 015, 016) show spatial correlation.</li>
                                <li><i class="fa-solid fa-wave-square text-gray"></i> Vibration baseline ambient acceleration spiking above 0.4g.</li>
                            </ul>
                            <div class="ai-metrics-footer">
                                <span>Spatial Correlation: <strong id="valSpatialCorr">0.87</strong></span>
                                <span>Temporal Trend: <strong id="valTempTrend">INCREASING</strong></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="section-title-bar">
                <i class="fa-solid fa-chart-line"></i>
                <h2>REAL-TIME SENSOR MONITORING (LAST 30 MINS)</h2>
            </div>
            <div class="dashboard-row grid-2-2">
                <div class="glass-card chart-card">
                    <div class="card-header">
                        <h4><i class="fa-solid fa-compass-drafting text-cyan"></i> GROUND TILT (DEGREES)</h4>
                        <span class="chart-curr-val" id="chartValTilt">1.82°</span>
                    </div>
                    <div class="chart-container">
                        <canvas id="chartTilt"></canvas>
                    </div>
                </div>
                <div class="glass-card chart-card">
                    <div class="card-header">
                        <h4><i class="fa-solid fa-arrows-up-down-left-right text-yellow"></i> SURFACE DISPLACEMENT (MM)</h4>
                        <span class="chart-curr-val" id="chartValDisp">12.6 mm</span>
                    </div>
                    <div class="chart-container">
                        <canvas id="chartDisplacement"></canvas>
                    </div>
                </div>
                <div class="glass-card chart-card">
                    <div class="card-header">
                        <h4><i class="fa-solid fa-wave-square text-green"></i> SURFACE VIBRATION (G)</h4>
                        <span class="chart-curr-val" id="chartValVib">0.42 g</span>
                    </div>
                    <div class="chart-container">
                        <canvas id="chartVibration"></canvas>
                    </div>
                </div>
                <div class="glass-card chart-card">
                    <div class="card-header">
                        <h4><i class="fa-solid fa-crack text-orange"></i> CRACK / STRUCTURAL MOVEMENT (MM)</h4>
                        <span class="chart-curr-val" id="chartValCrack">2.1 mm</span>
                    </div>
                    <div class="chart-container">
                        <canvas id="chartCrack"></canvas>
                    </div>
                </div>
            </div>

            <div class="dashboard-row grid-1-1">
                <div class="glass-card section-card">
                    <div class="card-header">
                        <div class="header-title">
                            <i class="fa-solid fa-table-cells"></i>
                            <h3>SPATIAL-TEMPORAL DEFORMATION ANALYSIS</h3>
                        </div>
                        <span class="badge badge-info">12 CORE ZONES</span>
                    </div>
                    <div class="card-body">
                        <p class="section-subtitle">Node correlation engine prevents false positives by assessing cluster spatial movement.</p>
                        <div class="spatial-grid" id="spatialNodeGrid">
                            </div>
                        <div class="spatial-analytics-summary">
                            <div class="summary-box">
                                <span class="label">Affected Zone:</span>
                                <span class="val text-orange" id="stAffectedZone">Panel B-04</span>
                            </div>
                            <div class="summary-box">
                                <span class="label">Neighbor Correlation:</span>
                                <span class="val text-cyan" id="stNeighborCorr">0.87</span>
                            </div>
                            <div class="summary-box">
                                <span class="label">Affected Nodes:</span>
                                <span class="val text-yellow" id="stAffectedNodes">4 / 12</span>
                            </div>
                            <div class="summary-box">
                                <span class="label">Risk Propagation:</span>
                                <span class="val text-orange" id="stRiskProp">MODERATE</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="glass-card section-card">
                    <div class="card-header">
                        <div class="header-title">
                            <i class="fa-solid fa-triangle-exclamation"></i>
                            <h3>EARLY WARNING & ACTIVE ALERTS</h3>
                        </div>
                        <button class="btn-sm" id="btnClearAlerts"><i class="fa-solid fa-check-double"></i> Acknowledge All</button>
                    </div>
                    <div class="card-body">
                        <div class="alerts-feed" id="alertsFeed">
                            <div class="alert-item critical">
                                <div class="alert-icon"><i class="fa-solid fa-circle-exclamation"></i></div>
                                <div class="alert-content">
                                    <div class="alert-header">
                                        <span class="alert-tag critical">CRITICAL</span>
                                        <span class="alert-title">NODE-014 detected abnormal deformation</span>
                                        <span class="alert-time">10:42:16</span>
                                    </div>
                                    <div class="alert-details">
                                        Surface Displacement: <strong>18.4 mm</strong> | Risk Score: <strong class="text-red">82 / 100</strong>
                                    </div>
                                    <div class="alert-action-rec">
                                        <i class="fa-solid fa-shield-cat"></i> Recommended Action: <strong>Immediate Field Verification & Sector B Evacuation Warning</strong>
                                    </div>
                                    <div class="alert-buttons">
                                        <button class="btn-xs btn-danger btn-ack">ACKNOWLEDGE</button>
                                        <button class="btn-xs btn-secondary btn-locate" data-node="NODE-014">VIEW LOCATION</button>
                                        <button class="btn-xs btn-warning btn-verify">FIELD VERIFICATION</button>
                                    </div>
                                </div>
                            </div>

                            <div class="alert-item warning">
                                <div class="alert-icon"><i class="fa-solid fa-triangle-exclamation"></i></div>
                                <div class="alert-content">
                                    <div class="alert-header">
                                        <span class="alert-tag warning">WARNING</span>
                                        <span class="alert-title">Panel B-04 deformation trend increasing</span>
                                        <span class="alert-time">10:38:05</span>
                                    </div>
                                    <div class="alert-details">
                                        Ground Tilt: <strong>2.91°</strong> | Risk Score: <strong class="text-orange">72 / 100</strong>
                                    </div>
                                    <div class="alert-buttons">
                                        <button class="btn-xs btn-warning btn-ack">ACKNOWLEDGE</button>
                                        <button class="btn-xs btn-secondary btn-locate" data-node="NODE-015">VIEW LOCATION</button>
                                    </div>
                                </div>
                            </div>

                            <div class="alert-item info">
                                <div class="alert-icon"><i class="fa-solid fa-battery-quarter"></i></div>
                                <div class="alert-content">
                                    <div class="alert-header">
                                        <span class="alert-tag info">ATTENTION</span>
                                        <span class="alert-title">NODE-009 battery below threshold</span>
                                        <span class="alert-time">09:15:22</span>
                                    </div>
                                    <div class="alert-details">
                                        Battery Level: <strong class="text-yellow">18%</strong> | RSSI: -84 dBm
                                    </div>
                                    <div class="alert-buttons">
                                        <button class="btn-xs btn-secondary btn-ack">DISMISS</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="glass-card section-card">
                <div class="card-header">
                    <div class="header-title">
                        <i class="fa-solid fa-table"></i>
                        <h3>SENSOR NETWORK STATUS</h3>
                    </div>
                    <div class="table-actions">
                        <input type="text" id="tableSearch" placeholder="Search Node ID or Location..." class="table-search-input">
                        <select id="tableFilterRisk" class="table-select">
                            <option value="ALL">All Risk Levels</option>
                            <option value="SAFE">Safe</option>
                            <option value="LOW">Low Risk</option>
                            <option value="WARNING">Warning</option>
                            <option value="CRITICAL">Critical</option>
                        </select>
                        <button class="btn-sm btn-cyan" id="btnExportCSV"><i class="fa-solid fa-file-csv"></i> Export CSV</button>
                        <button class="btn-sm btn-cyan" id="btnExportJSON"><i class="fa-solid fa-file-code"></i> Export JSON</button>
                    </div>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="industrial-table" id="sensorTable">
                            <thead>
                                <tr>
                                    <th data-sort="id">Node ID <i class="fa-solid fa-sort"></i></th>
                                    <th data-sort="location">Location <i class="fa-solid fa-sort"></i></th>
                                    <th data-sort="tilt">Tilt (°) <i class="fa-solid fa-sort"></i></th>
                                    <th data-sort="displacement">Displacement (mm) <i class="fa-solid fa-sort"></i></th>
                                    <th data-sort="vibration">Vibration (g) <i class="fa-solid fa-sort"></i></th>
                                    <th data-sort="crack">Crack (mm) <i class="fa-solid fa-sort"></i></th>
                                    <th data-sort="battery">Battery <i class="fa-solid fa-sort"></i></th>
                                    <th data-sort="rssi">RSSI (dBm) <i class="fa-solid fa-sort"></i></th>
                                    <th data-sort="risk">Risk Score <i class="fa-solid fa-sort"></i></th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody id="sensorTableBody">
                                </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="dashboard-row grid-1-1">
                <div class="glass-card section-card">
                    <div class="card-header">
                        <div class="header-title">
                            <i class="fa-solid fa-diagram-project"></i>
                            <h3>LoRa MESH NETWORK STATUS</h3>
                        </div>
                        <span class="badge badge-green">97.8% PACKET DELIVERY</span>
                    </div>
                    <div class="card-body">
                        <div class="lora-metrics-grid">
                            <div class="metric-mini">
                                <span class="lbl">Gateway ID</span>
                                <span class="val text-cyan">GW-01</span>
                            </div>
                            <div class="metric-mini">
                                <span class="lbl">Connected Nodes</span>
                                <span class="val text-green">22 / 24</span>
                            </div>
                            <div class="metric-mini">
                                <span class="lbl">Avg RSSI</span>
                                <span class="val">-72 dBm</span>
                            </div>
                            <div class="metric-mini">
